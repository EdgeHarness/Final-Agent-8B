{
    "version": 4,
    "configurePresets": [
        {
            "name": "xelite-cpu",
            "displayName": "Snapdragon X Elite — CPU (Oryon, recommended)",
            "inherits": "arm64-windows-llvm-release",
            "cacheVariables": {
                "GGML_CPU_KLEIDIAI": "ON",
                "GGML_OPENMP": "OFF",
                "GGML_LTO": "ON",
                "LLAMA_CURL": "OFF"
            }
        },
        {
            "name": "xelite-opencl",
            "displayName": "Snapdragon X Elite — CPU + Adreno X1-85 via OpenCL (slower, benchmark before using)",
            "inherits": "xelite-cpu",
            "cacheVariables": {
                "GGML_OPENCL": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "xelite-cpu",
            "configurePreset": "xelite-cpu",
            "configuration": "Release",
            "jobs": 12
        },
        {
            "name": "xelite-opencl",
            "configurePreset": "xelite-opencl",
            "configuration": "Release",
            "jobs": 12
        }
    ]
}
